          "foreground": "#F8FAFC",
          "border": "#64748B",
          "hoverBackground": "#17243B",
          "hoverForeground": "#F8FAFC",
          "activeBackground": "#1E304D",
          "activeForeground": "#F8FAFC"
        },
        "ghost": {
          "background": "#00000000",
          "foreground": "#CBD5E1",
          "border": "#00000000",
          "hoverBackground": "#101A2C",
          "hoverForeground": "#F8FAFC",
          "activeBackground": "#17243B",
          "activeForeground": "#F8FAFC"
        },
        "disabled": {
