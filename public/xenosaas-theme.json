{
  "metadata": {
    "name": "XenoSaas Black Blue Solar Red",
    "version": "1.0.0",
    "format": "semantic-color-tokens",
    "description": "Color-only migration for an existing Next.js website. This file is configuration data, not an executable framework preset.",
    "defaultTheme": "dark",
    "solarRed": "#FF2D7A",
    "integration": "Map semantic aliases into the existing styling system. Do not replace its configuration or add a theme library.",
    "scope": "colors-only"
  },
  "constraints": {
    "preserve": [
      "layout",
      "spacing",
      "typography",
      "content",
      "functionality",
      "routing",
      "architecture",
      "animation timing, motion paths, particle counts and interaction behavior"
    ],
    "avoid": [
      "global literal replacement without semantic context",
      "new dependencies",
      "new animations or effects",
      "forced dark mode overriding an existing theme preference",
      "lowering text or focus contrast"
    ],
    "lightMode": "No light palette is supplied. Preserve an existing light mode and its behavior; do not apply dark surfaces to it implicitly."
  },
  "palette": {
    "black": "#000000",
    "blue": "#3B82F6",
    "blueBright": "#60A5FA",
    "blueLight": "#93C5FD",
    "solarRed": "#FF2D7A",
    "solarRedLight": "#FF80AF",
    "white": "#FFFFFF"
  },
  "themes": {
    "dark": {
      "colorScheme": "dark",
      "backgrounds": {
        "canvas": "#000000",
        "page": "#05070D",
        "section": "#090F1C",
        "elevated": "#101A2C",
        "subtle": "#0B1220",
        "inverse": "#F8FAFC",
        "overlay": "#000000CC"
      },
      "foregrounds": {
